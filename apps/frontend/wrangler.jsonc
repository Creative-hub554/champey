{
  // Cloudflare Workers config for the Champey frontend, per
  // https://opennext.js.org/cloudflare/get-started (step 3).
  // Build:  pnpm --filter frontend run build:cf
  // Deploy: pnpm --filter frontend run deploy:cf
  // NOTE: production secrets (DATABASE_URL, CLERK_SECRET_KEY, …) are set with
  // `wrangler secret put` / the Cloudflare dashboard, not in this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "champey-frontend",
  // Matches @opennextjs/cloudflare's own template default; the adapter warns
  // when the date drifts >6 months behind (build.js compatibility-date check).
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    // Node.js APIs in Workers (required by the adapter).
    "nodejs_compat",
    // Allow fetching public URLs from the app.
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must match the worker "name" above.
      "service": "champey-frontend"
    }
  ],
  "r2_buckets": [
    {
      // Next.js incremental cache (ISR + fetch cache) shared across Worker
      // isolates — see open-next.config.ts (r2IncrementalCache). Create the
      // bucket once: wrangler r2 bucket create champey-isr-cache
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "champey-isr-cache"
    }
  ],
  "images": {
    // next/image optimization via Cloudflare Images. Enable Image
    // Transformations on the account BEFORE un commenting: with the binding
    // set but the service disabled, /_next/image fails hard; without the
    // binding it degrades gracefully to the original image (a warn + pass-
    // through in the adapter's images template).
    // "binding": "IMAGES"
  }
}
